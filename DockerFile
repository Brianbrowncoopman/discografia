# stage 1

FROM gradle:jdk-21-and-22 as builder

WORKDIR /app

COPY ./build.gradle .
COPY ./settings.gradle .

COPY src ./src 

RUN gradle build --no-daemon



# stage 2

FROM openjdk:21-jdk-slim

WORKDIR /app

COPY --from=builder /app/builder/libs*.jar discografia-1.jar

EXPOSE 443

CMD ["java", "-jar", "discografia-1.jar"]