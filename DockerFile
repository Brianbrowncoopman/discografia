# Stage 1: Construcción
FROM gradle:8.5-jdk21 AS builder

WORKDIR /app

# Copiar el wrapper y archivos de configuración para aprovechar el caché de capas
COPY gradlew .
COPY gradle gradle
COPY build.gradle .
COPY settings.gradle .
COPY src ./src

# Dar permisos y compilar (usando bootJar si es Spring Boot, o build estándar)
RUN chmod +x ./gradlew
RUN ./gradlew bootJar --no-daemon

# Stage 2: Ejecución
FROM openjdk:21-jdk-slim

WORKDIR /app

# Copiar el JAR generado desde la ruta correcta (build/libs/)
COPY --from=builder /app/build/libs/discografia-1.jar discografia-1.jar

# Render inyecta la variable PORT; aseguramos que la app la escuche si es necesario
ENV PORT=8080
EXPOSE 8080

CMD ["java", "-jar", "discografia-1.jar"]